# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS source
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      xz-utils; \
    rm -rf /var/lib/apt/lists/*
# GNOME keeps each release series in its own directory. libxslt is pinned by
# hand to the 1.1 series; the libxml2 directory follows VERSION (2.15 for
# 2.15.4), which ADD cannot derive, so that tarball is fetched with curl.
ARG LIBXSLT_VERSION
ARG LIBXSLT_SHA256
ADD --checksum=sha256:${LIBXSLT_SHA256} https://download.gnome.org/sources/libxslt/1.1/libxslt-${LIBXSLT_VERSION}.tar.xz /tmp/
ARG VERSION
ARG SOURCE_SHA256
RUN printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${LIBXSLT_VERSION}" | grep -Eqx '1\.1\.[0-9]+' \
      || { echo "unexpected LIBXSLT_VERSION: ${LIBXSLT_VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${SOURCE_SHA256}" | grep -Eqx '[0-9a-f]{64}' \
      || { echo "SOURCE_SHA256 must be the tarball's sha256" >&2; exit 1; }; \
    url="https://download.gnome.org/sources/libxml2/${VERSION%.*}/libxml2-${VERSION}.tar.xz"; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o /tmp/libxml2.tar.xz "$url"; \
    echo "${SOURCE_SHA256}  /tmp/libxml2.tar.xz" | sha256sum -c -; \
    mkdir -p /src/libxml2 /src/libxslt; \
    tar -xJf /tmp/libxml2.tar.xz -C /src/libxml2 --strip-components=1; \
    tar -xJf "/tmp/libxslt-${LIBXSLT_VERSION}.tar.xz" -C /src/libxslt --strip-components=1; \
    printf '%s\n' "$url" "https://download.gnome.org/sources/libxslt/1.1/libxslt-${LIBXSLT_VERSION}.tar.xz" \
      > /src/source-urls

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
# The base image's own packages are recorded first so they can be left out of
# runtime-deps; every image built from this list starts from the same base.
RUN dpkg-query -W -f '${Package}\n' | LC_ALL=C sort -u > /tmp/base-packages; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      pkgconf; \
    rm -rf /var/lib/apt/lists/*
COPY --link --from=source /src /src
ARG JOBS

# zlib, ICU, readline and the Python bindings are left out, so the programs
# link only the C library, which also provides iconv. --sysconfdir only sets
# the default catalog, file:///etc/xml/catalog; nothing is installed there.
# libxml2 also goes into /usr/local of this stage, where the libxslt build
# finds it. Ubuntu's libxml2-16 package has the same soname, so the RUNPATH
# keeps these libraries first in images that add it.
WORKDIR /src/libxml2
RUN ./configure \
      --prefix=/usr/local \
      --sysconfdir=/etc \
      --disable-static \
      --without-docs \
      --without-history \
      --without-python \
      --without-readline \
      --without-zlib \
      CFLAGS='-O2 -fno-semantic-interposition' \
      LDFLAGS='-Wl,-rpath,/usr/local/lib'; \
    make -j"${JOBS:-$(nproc)}"; \
    make install; \
    make DESTDIR=/out install-strip; \
    ldconfig; \
    test ! -e /out/etc

# The EXSLT crypto functions, which need libgcrypt, are left out, as are
# plugins and the Python bindings.
WORKDIR /src/libxslt
RUN ./configure \
      --prefix=/usr/local \
      --disable-static \
      --without-crypto \
      --without-plugins \
      --without-python \
      CFLAGS=-O2 \
      LDFLAGS='-Wl,-rpath,/usr/local/lib' \
      PKG_CONFIG_PATH=/usr/local/lib/pkgconfig; \
    make -j"${JOBS:-$(nproc)}"; \
    make DESTDIR=/out install-strip

ARG BASE_IMAGE
ARG VERSION
ARG SOURCE_SHA256
ARG LIBXSLT_VERSION
ARG LIBXSLT_SHA256
# configure leaves out an optional feature without failing when something it
# needs is missing, so xmllint's feature list is checked here. dict.c, list.c
# and timsort.h have notices of their own besides the Copyright files.
# runtime-deps lists the packages that own the libraries the programs load,
# minus the base image's packages, plus the packages in runtime-deps.ubuntu.
# The programs link only the C library. glibc loads its converters for
# ISO-8859-2, windows-1251, Shift_JIS and most other encodings at run time
# from libc-gconv-modules-extra, which the scan cannot see, so
# runtime-deps.ubuntu lists it. libc6 depends on it for now, but Debian
# intends to turn that back into a Recommends.
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps.extra \
    rm -rf \
      /out/usr/local/include \
      /out/usr/local/lib/cmake \
      /out/usr/local/lib/pkgconfig \
      /out/usr/local/share/aclocal \
      /out/usr/local/share/doc \
      /out/usr/local/share/gtk-doc \
      /out/usr/local/share/man; \
    rm -f \
      /out/usr/local/bin/xml2-config \
      /out/usr/local/bin/xslt-config \
      /out/usr/local/lib/*.la \
      /out/usr/local/lib/*Conf.sh; \
    bins=; \
    for f in /out/usr/local/bin/*; do bins="$bins ${f##*/}"; done; \
    test "$bins" = ' xmlcatalog xmllint xsltproc' || { echo "unexpected programs:$bins" >&2; exit 1; }; \
    export LD_LIBRARY_PATH=/out/usr/local/lib; \
    code="$(printf '%s' "${VERSION}" | awk -F. '{ printf "%d%02d%02d", $1, $2, $3 }')"; \
    xslt_code="$(printf '%s' "${LIBXSLT_VERSION}" | awk -F. '{ printf "%d%02d%02d", $1, $2, $3 }')"; \
    /out/usr/local/bin/xmllint --version 2> /tmp/xmllint-version; \
    wrong=; \
    grep -Fq "using libxml version ${code}" /tmp/xmllint-version || wrong="$wrong, version"; \
    for f in C14N Catalog DTDValid HTML Iconv Output Reader Regexps RelaxNG Schemas Threads Writer XInclude XPath XPointer; do \
      grep -Fq " $f " /tmp/xmllint-version || wrong="$wrong, $f missing"; \
    done; \
    for f in ICU Schematron Zlib; do \
      if grep -Fq " $f " /tmp/xmllint-version; then wrong="$wrong, $f built"; fi; \
    done; \
    if [ -n "$wrong" ]; then cat /tmp/xmllint-version >&2; echo "xmllint: ${wrong#, }" >&2; exit 1; fi; \
    /out/usr/local/bin/xsltproc --version > /tmp/xsltproc-version; \
    grep -Fq "Using libxml ${code}, libxslt ${xslt_code} " /tmp/xsltproc-version \
      || { cat /tmp/xsltproc-version >&2; exit 1; }; \
    grep -Fq "xsltproc was compiled against libxml ${code}, libxslt ${xslt_code} " /tmp/xsltproc-version \
      || { cat /tmp/xsltproc-version >&2; exit 1; }; \
    meta=/out/usr/local/share/randomcontainers/libxml2; \
    mkdir -p "$meta/licenses"; \
    cp /src/libxml2/Copyright "$meta/licenses/COPYING.libxml2"; \
    cp /src/libxslt/Copyright "$meta/licenses/COPYING.libxslt"; \
    for f in dict.c list.c timsort.h; do \
      awk '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (b ~ /Copyright/) { printf "%s", b; exit } }' \
        "/src/libxml2/$f" > "$meta/licenses/COPYING.${f%.*}"; \
      test -s "$meta/licenses/COPYING.${f%.*}"; \
    done; \
    echo "${VERSION}" > "$meta/version"; \
    cp /src/source-urls "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      echo "source-sha256: ${SOURCE_SHA256}"; \
      echo "libxslt: ${LIBXSLT_VERSION}"; \
      echo "libxslt-sha256: ${LIBXSLT_SHA256}"; \
      sed -n 's/^  \$ \(\.\/configure .*\)/\1/p' /src/libxml2/config.log /src/libxslt/config.log; \
      sed -n 2p /tmp/xmllint-version; \
    } > "$meta/buildinfo"; \
    find /out/usr/local -type f \( -perm -u+x -o -name '*.so*' \) -print0 \
      | xargs -0 ldd > /tmp/ldd 2>&1 || true; \
    if grep 'not found' /tmp/ldd; then exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// && $3 !~ /^\/(out\/)?usr\/local\// { print $3 }' /tmp/ldd | LC_ALL=C sort -u > /tmp/libs; \
    test -s /tmp/libs; \
    while read -r lib; do \
      real="$(readlink -f "$lib")"; \
      dpkg-query --search "*${real#/usr}"; \
    done < /tmp/libs | cut -d: -f1 | LC_ALL=C sort -u | LC_ALL=C comm -23 - /tmp/base-packages > /tmp/elf-deps; \
    if [ -s /tmp/elf-deps ]; then cat /tmp/ldd >&2; echo "unexpected run-time packages:" >&2; cat /tmp/elf-deps >&2; exit 1; fi; \
    LC_ALL=C sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=build /out/usr/local/ /usr/local/
# The programs find the libraries in /usr/local/lib through their RUNPATH;
# ldconfig adds them to the loader cache for everything else.
RUN set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /usr/local/share/randomcontainers/libxml2/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "xmllint"]
CMD ["--version"]
